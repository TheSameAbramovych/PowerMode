<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PowerMode</AssemblyName>
    <RootNamespace>PowerMode.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PowerMode.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>PowerMode.App.Program</StartupObject>
    <Version>1.0.0</Version>
    <Product>PowerMode</Product>
    <!-- WPF Fluent ThemeMode is still marked experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- WPF reads DPI awareness from the manifest; the WinForms-only advice does not apply (NotifyIcon only) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- WinForms ImplicitUsings would clash with WPF types; usings are explicit -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The UI is English only: do not ship the framework's translated resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerMode.Core\PowerMode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.Main starts the app; App.xaml only carries resources. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools\make-icon.ps1 and checked in; also the flyout window icon. -->
    <Resource Include="Assets\PowerMode.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

</Project>
